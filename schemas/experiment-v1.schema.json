{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sfv-experiment-v1",
  "title": "SFV Experiment Configuration v1",
  "type": "object",
  "required": ["schemaVersion", "experimentId", "sessions"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "experimentId": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "object",
      "properties": {
        "datasetPath": {
          "type": "string"
        },
        "dataset": {
          "type": "object"
        },
        "videos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "playlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "capacityMbps": {
          "type": "number",
          "minimum": 0
        },
        "capacityTrace": {
          "type": "array"
        },
        "capacityGenerator": {
          "type": "object"
        },
        "faults": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "videoId": {
                "type": "string"
              },
              "resourceType": {
                "enum": ["manifest", "init", "media"]
              },
              "representationId": {
                "type": "string"
              },
              "segmentIndex": {
                "type": "integer",
                "minimum": 0
              },
              "attempt": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "timingDefaults": {
      "type": "object"
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["abr"],
        "properties": {
          "abr": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "enum": ["current", "prefetch"]
              },
              "config": {
                "type": "object"
              }
            }
          },
          "config": {
            "type": "object",
            "properties": {
              "cache": {
                "type": "object",
                "properties": {
                  "maxBytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "requestRetry": {
                "type": "object",
                "properties": {
                  "maxRetries": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "delayS": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "scheduling": {
                "type": "object",
                "properties": {
                  "maxConcurrentRequests": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "userModel": {
                "type": "object"
              },
              "sessionStartTimeS": {
                "type": "number",
                "minimum": 0
              },
              "sessionEndTimeS": {
                "type": "number",
                "minimum": 0
              },
              "diagnostics": {
                "type": "object",
                "properties": {
                  "abrDecisions": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
